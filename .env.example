# SolarResolve Environment Variables Example

# Application Config
APP_NAME=SolarResolve
APP_ENV=development
DEBUG=True

# API Server
HOST=127.0.0.1
PORT=8000

# AI Integration
AI_PROVIDER=synthetic
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://solar-resolve-24.vercel.app
