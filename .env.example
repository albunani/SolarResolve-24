# SolarResolve Environment Variables Example

# Application Config
APP_NAME=SolarResolve
APP_ENV=development
DEBUG=True

# API Server
HOST=127.0.0.1
PORT=8000

# AI Integration
# Get your Gemini API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security
# Secret key for signing session tokens (if needed later)
SECRET_KEY=your_super_secret_key_here
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
