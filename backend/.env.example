# Environment variables for the SolarResolve backend
# Copy to .env and supply real values before deploying.
# Do not commit .env to source control.

# Application
APP_NAME=SolarResolve
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production

# Server
HOST=127.0.0.1
PORT=8000

# CORS - comma-separated list of allowed origins
# For local dev, include localhost:5173. For prod, include your vercel app domain.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://solar-resolve-24.vercel.app

# AI provider
AI_PROVIDER=synthetic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_SECONDS=20

