# Environment variables for the SolarResolve backend
# Copy to .env and supply real values before deploying.
# Do not commit .env to source control.

# Application
APP_NAME=SolarResolve
APP_VERSION=0.1.0
ENVIRONMENT=development          # development | staging | production

# Server
HOST=127.0.0.1
PORT=8000

# CORS — comma-separated list of allowed origins
# In development, the Vite dev server runs on 5173.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI provider — not used on Day 3; add when the AI phase is approved
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-1.5-flash
